<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>sweep.serve.llama</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/llama</string>
      <string>serve</string>
      <string>-hf</string>
      <string>sweepai/sweep-next-edit-1.5b</string>
      <string>--host</string>
      <string>127.0.0.1</string>
      <string>--port</string>
      <string>43482</string>
      <string>offline</string>
    </array>
    <key>RunAtLoad</key>
    <true />
    <key>KeepAlive</key>
    <true />
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/llama-server.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/llama-server.log</string>
  </dict>
</plist>
